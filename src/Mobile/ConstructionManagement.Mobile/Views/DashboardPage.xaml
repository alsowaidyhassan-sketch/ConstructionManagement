<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ConstructionManagement.Mobile.Views.DashboardPage"
             BackgroundColor="{StaticResource Background}"
             Title="مشاريعي"
             FlowDirection="RightToLeft">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Frame CornerRadius="10" BackgroundColor="White" HasShadow="True" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="فيلا الرمال - مشروع رقم 1001" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Label Text="نسبة الإنجاز: 45%" FontSize="14" TextColor="Gray" />
                    <ProgressBar Progress="0.45" ProgressColor="{StaticResource Primary}" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="التفاصيل" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="5" />
                        <Button Text="الدفعات" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Primary}" BorderWidth="1" CornerRadius="5" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ConstructionManagement.Mobile.Views.LoginPage"
             BackgroundColor="{StaticResource Background}"
             Title="تسجيل الدخول"
             FlowDirection="RightToLeft">
    <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">
        <Label Text="بوابة العميل" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource Primary}" />
        <Entry x:Name="UsernameEntry" Placeholder="اسم المستخدم" Keyboard="Text" />
        <Entry x:Name="PasswordEntry" Placeholder="كلمة المرور" IsPassword="True" />
        <Button Text="دخول" BackgroundColor="{StaticResource Primary}" TextColor="White" Clicked="OnLoginClicked" CornerRadius="8" HeightRequest="50" />
    </VerticalStackLayout>
</ContentPage>
